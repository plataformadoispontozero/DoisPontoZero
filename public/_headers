/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; frame-src 'self' blob: https://challenges.cloudflare.com https://docs.google.com https://drive.google.com; connect-src https://apis.google.com https://www.googleapis.com https://challenges.cloudflare.com 'self' https://*.supabase.co wss://*.supabase.co https://*.livekit.cloud wss://*.livekit.cloud https://fonts.googleapis.com; media-src 'self' blob:; object-src 'none'; frame-ancestors 'self';

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/service-worker.js
  Cache-Control: no-cache

# Public access links carry credentials: never cache them or index their pages.
/approve-calendar/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/apresentacao/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/showcase/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/b/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive
