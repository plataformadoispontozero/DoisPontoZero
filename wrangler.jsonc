{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doispontozero",
  "account_id": "66254d95fa3a429d98bece1da32c1f8c",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/assets/*"
    ]
  },
  "main": "worker/index.ts"
}
