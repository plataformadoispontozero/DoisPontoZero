# ============================================================
# DOIS.ZERO | CREATIVE AGENCY OS
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ============================================================
# NOTA DE SEGURANÇA:
# 1. NUNCA faça commit de credenciais ou tokens reais para o GitHub.
# 2. NUNCA exponha 'service_role' no frontend (apenas no backend/CI ou scripts restritos).
# 3. NUNCA armazene tokens confidenciais OAuth em localStorage.
# ============================================================

# ------------------------------------------------------------
# 1. VARIÁVEIS PÚBLICAS DO FRONTEND (Vite / React)
# ------------------------------------------------------------
# Porta local do servidor de desenvolvimento Vite
VITE_PORT=5173

# Identificador ou nome do Workspace padrão em modo local/demo
VITE_WORKSPACE_NAME="Matriz Criativa"

# URL pública do projeto Supabase (acessível pelo navegador)
# Exemplo Staging/Produção: https://pvkhlobsiszrjtblpruu.supabase.co
VITE_SUPABASE_URL=https://pvkhlobsiszrjtblpruu.supabase.co

# Chave anônima pública (anon / publishable key) do Supabase (com RLS ativado)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# ------------------------------------------------------------
# 2. VARIÁVEIS PRIVADAS DO BACKEND / EDGE FUNCTIONS (NUNCA VITE_)
# ------------------------------------------------------------
# Chave mestra de serviço (service_role) — USO EXCLUSIVO EM EDGE FUNCTIONS / SCRIPTS DE CI
# ATENÇÃO: NUNCA ADICIONE O PREFIXO VITE_ NESTA CHAVE!
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada

# ------------------------------------------------------------
# 3. INTEGRAÇÕES EXTERNAS (OAUTH & STORAGE)
# ------------------------------------------------------------
# Google Drive / Calendar Integration (OAuth 2.0 Client ID público para popup)
VITE_GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com

# Segredo do cliente Google (USO EXCLUSIVO NO BACKEND / SUPABASE VAULT)
GOOGLE_CLIENT_SECRET=seu-google-client-secret-privado

# ------------------------------------------------------------
# 4. CONFIGURAÇÕES DE DEPLOY / HOSTING (Vercel / Netlify / Cloudflare)
# ------------------------------------------------------------
# Ambiente da aplicação: development | staging | production
VITE_APP_ENV=production

# URL canônica do frontend para redirecionamentos OAuth seguros
VITE_APP_URL=https://app.doiszero.com.br

# Demonstração explícita, somente loopback e sem Supabase configurado. Nunca habilitar em staging/produção.
VITE_ENABLE_LOCAL_DEMO=false

# Site público (slug deve corresponder ao conteúdo publicado da agência)
VITE_PUBLIC_SITE_SLUG=dois-zero
# Ativar somente no build de preview criativo, não na produção.
VITE_PUBLIC_SITE_PREVIEW=false
# Chave pública do widget Turnstile para o formulário, após configurar domínios.
VITE_TURNSTILE_SITE_KEY=

# Somente nos secrets da Edge Function, nunca no frontend ou no GitHub:
TURNSTILE_SECRET_KEY=
PUBLIC_SITE_ALLOWED_ORIGINS=https://doispontozero.renatodesigner.com.br
